<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="crazy2fly_usable">
    <xacro:include filename="$(find acts_simulator)/urdf/crazy2fly.urdf.xacro" />

    <xacro:arg name="prefix" default="drone1_"/>
    <xacro:arg name="x" default="0.0"/>
    <xacro:arg name="y" default="0.0"/>
    <xacro:arg name="z" default="0.0"/>

    <xacro:crazy2fly prefix="$(arg prefix)" />
</robot>