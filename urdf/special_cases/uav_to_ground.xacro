<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="uav_to_ground">
    <xacro:include filename="$(find acts_simulator)/urdf/uav_cable_assembly.urdf.xacro"/>

    <xacro:arg name="id" default="1"/>
    <xacro:arg name="x" default="0.0"/>
    <xacro:arg name="y" default="0.0"/>
    <xacro:arg name="z" default="0.0"/>
    

    <link name="world"> </link>

    <xacro:add_drone 
        id="1" 
        segments="10" 
        length="1.0" 
        panel_link="world"
        cable_roll="0.0" 
        cable_pitch="0.0" 
        cable_yaw="0.0"
        />

</robot>
