<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="acts_system">

  <xacro:include filename="$(find acts_simulator)/urdf/components/cable_guide.xacro" />

  <link name="world"/>

  <xacro:cable_guide prefix="guide" 
    parent_link="world"
    x="5" y="2" z="3"
  />
  <gazebo reference="guide_link">
  <collision name="guide_collision">
    <surface>
      <contact>
        <ode>
          <kp>10000.0</kp> 
          <kd>100.0</kd>
          <min_depth>0.005</min_depth>
          <max_vel>0.1</max_vel>
        </ode>
      </contact>
      <friction>
        <ode>
          <mu>0.05</mu>
          <mu2>0.05</mu2>
        </ode>
      </friction>
    </surface>
  </collision>
</gazebo>

 
</robot>