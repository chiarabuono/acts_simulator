<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
  <xacro:macro name="ground_hook" params="prefix anchorX anchorY anchorZ parent_link:=chassis_link">

    <link name="${prefix}ground_hook">
      <inertial>
        <mass value="0.001"/>
        <inertia ixx="1e-6" ixy="0" ixz="0" iyy="1e-6" iyz="0" izz="1e-6"/>
      </inertial>
      <visual>
        <geometry><sphere radius="0.03"/></geometry>
      </visual>
    </link>

    <joint name="${prefix}base_to_hook_joint" type="fixed">
      <parent link="${parent_link}"/>
      <child link="${prefix}ground_hook"/>
      <origin xyz="${anchorX} ${anchorY} ${anchorZ}" rpy="0 0 0"/>
    </joint>

    <gazebo reference="${prefix}base_to_hook_joint">
      <preserveFixedJoint>true</preserveFixedJoint>
    </gazebo>

    <gazebo>
      <plugin filename="libgz-sim-detachable-joint-system.so" name="gz::sim::systems::DetachableJoint">
        <parent_link>${prefix}ground_hook</parent_link>
        <child_model>acts</child_model> 
        <child_link>${prefix}base_link</child_link>
      </plugin>
    </gazebo>

  </xacro:macro>
</robot>