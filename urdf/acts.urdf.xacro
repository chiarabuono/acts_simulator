<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="acts_system">

  <xacro:include filename="panel.urdf.xacro" />
  <xacro:include filename="uav_cable_assembly.urdf.xacro" />

  <link name="world"/>

  <joint name="world_to_panel_joint" type="fixed">
    <parent link="world"/>
    <child link="main_panel_base_link"/>
    <origin xyz="0 0 0.0" rpy="0 0 0"/> 
  </joint>

  <xacro:panel_platform 
    prefix="main_panel_" 
    mass="100.0" width="3.0" depth="3.0" height="0.2" />

  <xacro:add_drone 
    id="1" 
    segments="10" 
    length="1.0" 
    panel_link="main_panel_base_link" 
    x_off="0.0" 
    y_off="0.0" 
    z_off="0.1"/> 

  <gazebo>
    <self_collide>true</self_collide>
  </gazebo>

  <gazebo reference="drone1_base_link">
    <self_collide>true</self_collide>
    <collision name="drone1_total_collision">
      <geometry>
        <box size="0.3 0.3 0.1"/>
      </geometry>
      <surface>
        <contact>
          <collide_bitmask>0x01</collide_bitmask>
        </contact>
        <friction>
          <ode>
            <mu>1.0</mu>
            <mu2>1.0</mu2>
          </ode>
        </friction>
      </surface>
    </collision>
  </gazebo>

  <gazebo reference="main_panel_base_link">
    <collision name="panel_surface_collision">
      <geometry>
        <box size="3.0 3.0 0.2"/>
      </geometry>
      <surface>
        <contact>
          <collide_bitmask>0x01</collide_bitmask>
        </contact>
      </surface>
    </collision>
  </gazebo>

  <gazebo reference="drone1_cable_to_drone_joint">
    <preserveFixedJoint>true</preserveFixedJoint>
    <disableFixedJointLumping>true</disableFixedJointLumping>
  </gazebo>

</robot>