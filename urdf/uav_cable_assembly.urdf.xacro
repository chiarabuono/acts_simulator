<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <xacro:include filename="$(find acts_simulator)/urdf/crazy2fly.urdf.xacro" />
  <xacro:include filename="$(find acts_simulator)/urdf/components/cable_component.xacro" />

  <xacro:macro name="uav_towing_unit" params="prefix panel_link x y z segments length radius mass">
    
    <xacro:uav_cable 
      prefix="${prefix}" 
      parent_link="base_link" 
      is_flexible="true" 
      segments="${segments}" 
      length="${length}" 
      radius="${radius}" 
      mass="${mass}" />

    <joint name="${prefix}cable_to_panel_joint" type="continuous">
      <parent link="${prefix}link_${segments}"/> 
      <child link="${panel_link}"/>
      <origin xyz="${x} ${y} ${z}" rpy="0 0 0"/>
      <axis xyz="1 0 0"/>
      <dynamics damping="0.1" friction="0.01"/>
    </joint>
  </xacro:macro>
</robot>

