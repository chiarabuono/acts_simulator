<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
  <xacro:include filename="$(find acts_simulator)/urdf/crazy2fly.urdf.xacro" />
  <xacro:include filename="$(find acts_simulator)/urdf/components/cable_component.xacro" />

  <xacro:macro name="uav_towing_unit" params="prefix panel_link x y z segments length radius mass attach_to_panel">
    <joint name="world_to_${prefix}_joint" type="fixed">
      <parent link="world"/>
      <child link="${prefix}base_link"/>
      <origin xyz="${x} ${y} ${z}" rpy="0 0 0"/>
    </joint>

    <xacro:crazy2fly prefix="${prefix}" />

    <xacro:uav_cable 
      prefix="${prefix}" 
      parent_link="${prefix}base_link" 
      is_flexible="true" 
      segments="${segments}" 
      length="${length}" 
      radius="${radius}" 
      mass="${mass}" />

  <link name="${prefix}hook_link">
    <inertial>
      <mass value="0.01"/>
      <inertia ixx="1e-6" ixy="0" ixz="0" iyy="1e-6" iyz="0" izz="1e-6"/>
    </inertial>
    <visual>
      <geometry><sphere radius="0.005"/></geometry>
      <material name="red"/>
    </visual>
  </link>

  <joint name="${prefix}cable_to_hook_joint" type="revolute">
    <parent link="${prefix}link_${segments}"/> 
    <child link="${prefix}hook_link"/>
    <origin xyz="0 0 ${-length/segments}" rpy="0 0 0"/>
    <limit effort="0" lower="0" upper="0" velocity="0"/>
  </joint>

    <xacro:if value="${attach_to_panel}">
      <joint name="${prefix}hook_to_panel_joint" type="continuous">
        <parent link="${prefix}hook_link"/> 
        <child link="${panel_link}"/>
        <axis xyz="1 0 0"/>
        <origin xyz="0 0 -0.1" rpy="0 0 0"/>
      </joint>
    </xacro:if>
  </xacro:macro>

  <xacro:macro name="add_drone" params="id x y z segments length handle_id:=1 primary:=false">
    <xacro:uav_towing_unit 
      prefix="drone${id}_" 
      panel_link="main_panel_base_link" 
      x="${x}" y="${y}" z="${z}" 
      segments="${segments}" 
      length="${length}" radius="0.01" mass="0.1" 
      attach_to_panel="${primary}" />

    <xacro:unless value="${primary}">
      <gazebo>
        <plugin filename="gz-sim-detachable-joint-system" name="gz::sim::systems::DetachableJoint">
          <parent_link>drone${id}_hook_link</parent_link>
          <child_model>acts_system</child_model>
          <child_link>main_panel_handle_${handle_id}</child_link>
          <attach_topic>/drone${id}/attach</attach_topic>
          <detach_topic>/drone${id}/detach</detach_topic>
        </plugin>
      </gazebo>
    </xacro:unless>
  </xacro:macro>

</robot>