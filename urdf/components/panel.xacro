<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <xacro:macro name="panel" params="link_name mass x y z material_name material_color">
    
    <link name="${link_name}">
      <inertial>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <mass value="${mass}"/>
        <inertia 
          ixx="${(1/12) * mass * (y*y + z*z)}" ixy="0.0" ixz="0.0"
          iyy="${(1/12) * mass * (x*x + z*z)}" iyz="0.0"
          izz="${(1/12) * mass * (x*x + y*y)}"/>
      </inertial>

      <visual>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <box size="${x} ${y} ${z}"/>
        </geometry>
        <material name="${material_name}">
          <color rgba="${material_color}"/>
        </material>
      </visual>

      <collision>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <box size="${x} ${y} ${z}"/>
        </geometry>
      </collision>
    </link>

    <gazebo reference="${link_name}">
      <material>Gazebo/${material_name}</material>
    </gazebo>

  </xacro:macro>

</robot>