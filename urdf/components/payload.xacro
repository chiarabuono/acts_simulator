<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <xacro:macro name="standard_inertia">
    <inertial>
      <mass value="2.0" />
      <inertia ixx="0.1" ixy="0.0" ixz="0.0" iyy="0.1" iyz="0.0" izz="0.1" />
    </inertial>
  </xacro:macro>

  <xacro:macro name="payload" params="x y z">
    <link name="payload">
        <xacro:standard_inertia />
        <visual>
          <geometry><box size="1.0 1.0 0.05" /></geometry>
        </visual>
        <collision name="payload_collision">
          <geometry><box size="5.0 5.0 0.05" /></geometry>
        </collision>
    </link>

    <joint name="ugv1_to_payload" type="fixed">
      <parent link="ugv1_cable" />
      <child link="payload" />
      <origin xyz="${x} ${y} ${z}" rpy="0 0 0" />
    </joint>
  </xacro:macro>

</robot>