<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
  <xacro:macro name="pulley" params="prefix parent_link">

    <link name="base_${prefix}_x_link"><inertial><mass value="0.01"/>
    <inertia ixx="1e-5" ixy="0" ixz="0" iyy="1e-5" iyz="0" izz="1e-5"/> </inertial>
  </link>
  
  <joint name="joint_${prefix}_x" type="prismatic">
    <parent link="${parent_link}"/>
    <child link="base_${prefix}_x_link"/>
    <origin xyz="0 0 0" rpy="0 0 0"/><axis xyz="1 0 0"/>
    <limit effort="1000.0" lower="-100.0" upper="100.0" velocity="5.0"/>
  </joint>

  <link name="base_${prefix}_y_link">
    <inertial>
      <mass value="0.01"/> 
      <inertia ixx="1e-5" ixy="0" ixz="0" iyy="1e-5" iyz="0" izz="1e-5"/>
    </inertial>
  </link>

  <joint name="joint_${prefix}_y" type="prismatic">
    <parent link="base_${prefix}_x_link"/>
    <child link="base_${prefix}_y_link"/>
    <origin xyz="0 0 0" rpy="0 0 0"/><axis xyz="0 1 0"/>
    <limit effort="1000.0" lower="-100.0" upper="100.0" velocity="5.0"/>
  </joint>

  <link name="base_${prefix}_z_link">
    <inertial>
      <mass value="0.01"/>
      <inertia ixx="1e-5" ixy="0" ixz="0" iyy="1e-5" iyz="0" izz="1e-5"/>
    </inertial>
  </link>

  <joint name="joint_${prefix}_z" type="prismatic">
    <parent link="base_${prefix}_y_link"/>
    <child link="base_${prefix}_z_link"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="-100.0" upper="100.0" effort="1000" velocity="5.0"/>
  </joint>
  </xacro:macro>
  

  <xacro:macro name="position_controlled_pulley" params="prefix parent_link">
    <xacro:pulley prefix="${prefix}" parent_link="${parent_link}"/>

    <ros2_control name="ControlSystem_${prefix}" type="system">
      <hardware> <plugin>gz_ros2_control/GazeboSimSystem</plugin></hardware>
      <joint name="joint_${prefix}_x"> <command_interface name="position"/><state_interface name="position"/> </joint>
      <joint name="joint_${prefix}_y"> <command_interface name="position"/><state_interface name="position"/> </joint>
      <joint name="joint_${prefix}_z"> <command_interface name="position"/><state_interface name="position"/> </joint>
    </ros2_control>
  </xacro:macro>


   <xacro:macro name="forceTorque_controlled_pulley" params="prefix parent_link">
    <xacro:pulley prefix="${prefix}" parent_link="${parent_link}"/>

    <ros2_control name="ControlSystem_${prefix}" type="system">
      <hardware> <plugin>gz_ros2_control/GazeboSimSystem</plugin> </hardware>
      <joint name="joint_${prefix}_x">
        <command_interface name="position"/>
        <state_interface name="position"/>
      </joint>

      <joint name="joint_${prefix}_y">
        <command_interface name="position"/>
        <state_interface name="position"/>
      </joint>
      
      <joint name="joint_${prefix}_z"> 
        <command_interface name="effort"/> 
        <state_interface name="position"/>
        <state_interface name="velocity"/>
        <state_interface name="effort"/>
      </joint>
    </ros2_control>
  </xacro:macro>

</robot>