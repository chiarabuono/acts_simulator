<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <xacro:macro name="pulley" params="prefix parent_link">

<link name="${prefix}base_x_link"><inertial><mass value="0.01"/>
    <inertia ixx="1e-5" ixy="0" ixz="0" iyy="1e-5" iyz="0" izz="1e-5"/> </inertial>
  </link>
  
  <joint name="${prefix}joint_pulley_x" type="prismatic">
    <parent link="${parent_link}"/>
    <child link="${prefix}base_x_link"/>
    <origin xyz="0 0 0.0" rpy="0 0 0"/><axis xyz="1 0 0"/>
    <limit effort="1000.0" lower="-10.0" upper="10.0" velocity="2.0"/>
    <dynamics damping="10.0" friction="0.5"/>
  </joint>

  <link name="${prefix}base_y_link">
    <inertial>
      <mass value="0.01"/> 
      <inertia ixx="1e-5" ixy="0" ixz="0" iyy="1e-5" iyz="0" izz="1e-5"/>
    </inertial>
  </link>

  <joint name="${prefix}joint_pulley_y" type="prismatic">
    <parent link="${prefix}base_x_link"/>
    <child link="${prefix}base_y_link"/>
    <origin xyz="0 0 0" rpy="0 0 0"/><axis xyz="0 1 0"/>
    <limit effort="1000.0" lower="-10.0" upper="10.0" velocity="2.0"/>
    <dynamics damping="10.0" friction="0.5"/>
  </joint>

  <link name="${prefix}base_z_link">
    <inertial>
      <mass value="0.01"/>
      <inertia ixx="1e-5" ixy="0" ixz="0" iyy="1e-5" iyz="0" izz="1e-5"/>
    </inertial>
  </link>

  <joint name="${prefix}joint_pulley_z" type="prismatic">
    <parent link="${prefix}base_y_link"/>
    <child link="${prefix}base_z_link"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit effort="1000.0" lower="-1.2" upper="10.0" velocity="2.0"/>
    <dynamics damping="10.0" friction="0.5"/>
  </joint>

    <ros2_control name="${prefix}GazeboSimSystem" type="system">
        <hardware><plugin>gz_ros2_control/GazeboSimSystem</plugin></hardware>
        <joint name="${prefix}joint_pulley_x"><command_interface name="position"/><state_interface name="position"/></joint>
        <joint name="${prefix}joint_pulley_y"><command_interface name="position"/><state_interface name="position"/></joint>
        <joint name="${prefix}joint_pulley_z"><command_interface name="position"/><state_interface name="position"/></joint>
    </ros2_control>


</xacro:macro>

</robot>