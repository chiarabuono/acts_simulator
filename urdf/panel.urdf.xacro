<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <xacro:macro name="panel_box_inertia" params="m w d h">
    <inertial>
      <mass value="${m}"/>
      <inertia ixx="${(m/12) * (d*d + h*h)}" ixy="0.0" ixz="0.0"
               iyy="${(m/12) * (w*w + h*h)}" iyz="0.0"
               izz="${(m/12) * (w*w + d*d)}"/>
    </inertial>
  </xacro:macro>

  <xacro:macro name="handle" params="prefix suffix x y z">
    <link name="${prefix}handle_${suffix}">
      <inertial>
        <mass value="0.001"/>
        <inertia ixx="1e-9" ixy="0" ixz="0" iyy="1e-9" iyz="0" izz="1e-9"/>
      </inertial>
    </link>

    <joint name="${prefix}handle_${suffix}_joint" type="fixed">
      <parent link="${prefix}base_link"/>
      <child link="${prefix}handle_${suffix}"/>
      <origin xyz="${x} ${y} ${z}" rpy="0 0 0"/>
    </joint>
  </xacro:macro>

  <xacro:macro name="panel_platform" params="prefix mass width depth height">
    
    <link name="${prefix}base_link">
      <xacro:panel_box_inertia m="${mass}" w="${width}" d="${depth}" h="${height}" />
      <visual>
        <geometry><box size="${width} ${depth} ${height}"/></geometry>
        <material name="grey"><color rgba="0.5 0.5 0.5 1"/></material>
      </visual>
      <collision>
        <geometry><box size="${width} ${depth} ${height}"/></geometry>
      </collision>
    </link>

    <xacro:handle prefix="${prefix}" suffix="1" x="0.2"  y="0.2"  z="${height/2}" />
    <xacro:handle prefix="${prefix}" suffix="2" x="0.2"  y="-0.2" z="${height/2}" />
    <xacro:handle prefix="${prefix}" suffix="3" x="-0.2" y="-0.2" z="${height/2}" />
    <xacro:handle prefix="${prefix}" suffix="4" x="-0.2" y="0.2"  z="${height/2}" />

  </xacro:macro>
</robot>