<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <xacro:macro name="panel_box_inertia" params="m w d h">
    <inertial>
      <mass value="${m}"/>
      <inertia ixx="${(m/12) * (d*d + h*h)}" ixy="0.0" ixz="0.0"
               iyy="${(m/12) * (w*w + h*h)}" iyz="0.0"
               izz="${(m/12) * (w*w + d*d)}"/>
    </inertial>
  </xacro:macro>

  <xacro:macro name="panel_platform" params="prefix mass:=1.0 width:=1.0 depth:=1.0 height:=0.1">
    <link name="${prefix}base_link">
      <xacro:panel_box_inertia m="${mass}" w="${width}" d="${depth}" h="${height}" />
      
      <visual>
        <geometry>
          <box size="${width} ${depth} ${height}"/>
        </geometry>
        <material name="grey"><color rgba="0.5 0.5 0.5 1"/></material>
      </visual>
      
      <collision>
        <geometry>
          <box size="${width} ${depth} ${height}"/>
        </geometry>
      </collision>
    </link>

    <gazebo reference="${prefix}base_link">
      <selfCollide>true</selfCollide>
    </gazebo>
  </xacro:macro>

</robot>