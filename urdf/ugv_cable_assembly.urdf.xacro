<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
  <xacro:include filename="$(find acts_simulator)/urdf/components/cable_component.xacro" />
  <xacro:include filename="$(find acts_simulator)/urdf/components/ugv_component.xacro" />

  <xacro:macro name="add_ugv" params="id segments length x_off:=0 y_off:=0 z_off:=0 
                                       cable_roll:=0 cable_pitch:=0 cable_yaw:=0 panel_link:=''">
    <xacro:property name="prefix" value="ugv${id}_" />

    <xacro:ugv_component prefix="${prefix}" x="0" y="0" z="0" />

    <link name="${prefix}cable_root_link">
      <inertial>
        <mass value="0.0001"/>
        <inertia ixx="1e-6" ixy="0" ixz="0" iyy="1e-6" iyz="0" izz="1e-6"/>
      </inertial>
    </link>

    <xacro:unless value="${panel_link == ''}">
      <joint name="${prefix}panel_to_cable_joint" type="fixed">
        <parent link="${panel_link}"/>
        <child link="${prefix}cable_root_link"/>
        <origin xyz="${x_off} ${y_off} ${z_off}" rpy="0 0 0"/>
      </joint>
    </xacro:unless>

    <link name="${prefix}virtual_top_link">
      <inertial>
        <mass value="0.0001"/>
        <inertia ixx="1e-6" ixy="0" ixz="0" iyy="1e-6" iyz="0" izz="1e-6"/>
      </inertial>
    </link>

    <joint name="${prefix}joint_x_cable_to_ugv" type="revolute">
      <parent link="${prefix}cable_root_link"/>
      <child link="${prefix}virtual_top_link"/>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <axis xyz="1 0 0"/>
      <limit lower="-1.5708" upper="1.5708" effort="20" velocity="2.0"/>
      <dynamics damping="0.1" friction="0.01"/>
    </joint>

    <link name="${prefix}actuated_cable_base_link">
      <inertial>
        <mass value="0.0001"/>
        <inertia ixx="1e-6" ixy="0" ixz="0" iyy="1e-6" iyz="0" izz="1e-6"/>
      </inertial>
    </link>

    <joint name="${prefix}joint_y_cable_to_ugv" type="revolute">
      <parent link="${prefix}virtual_top_link"/>
      <child link="${prefix}actuated_cable_base_link"/>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <axis xyz="0 1 0"/>
      <limit lower="-1.5708" upper="1.5708" effort="20" velocity="2.0"/>
      <dynamics damping="0.1" friction="0.01"/>
    </joint>

    <xacro:ugv_cable 
      prefix="${prefix}" 
      parent_link="${prefix}actuated_cable_base_link"
      is_flexible="true"
      segments="${segments}" 
      length="${length}"
      cable_roll="${cable_roll}" 
      cable_pitch="${cable_pitch}"
      cable_yaw="${cable_yaw}"
      radius="0.005" mass="0.01" />

    <joint name="${prefix}cable_to_base_fixed_joint" type="fixed">
      <parent link="${prefix}link_${segments}"/>
      <child link="${prefix}base_link"/>
      <origin xyz="0 0 0" rpy="0 0 0"/>
    </joint>

    <gazebo reference="${prefix}panel_to_cable_joint">
      <preserveFixedJoint>true</preserveFixedJoint>
    </gazebo>

    <gazebo reference="${prefix}cable_to_base_fixed_joint">
      <preserveFixedJoint>true</preserveFixedJoint>
    </gazebo>

  </xacro:macro> 
</robot>