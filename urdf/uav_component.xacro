<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
  <xacro:macro name="uav_platform" params="prefix">
    <link name="${prefix}base_link">
      <inertial>
        <mass value="2.0"/>
        <inertia ixx="0.05" ixy="0.0" ixz="0.0" iyy="0.05" iyz="0.0" izz="0.08"/>
      </inertial>
      <visual>
        <geometry>
          <box size="0.5 0.5 0.2"/> </geometry>
        <material name="blue">
            <color rgba="0 0 1 1"/>
        </material>
      </visual>
      <collision>
        <geometry>
          <box size="0.5 0.5 0.2"/>
        </geometry>
      </collision>
    </link>
  </xacro:macro>
</robot>